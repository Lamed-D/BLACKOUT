# ============================================================
# BLACKOUT labs — 환경설정 예시
# 사용법: 이 파일을 `labs/.env` 로 복사한 뒤 값을 채웁니다.
#   cp labs/.env.example labs/.env
# docker compose 는 compose 파일이 있는 디렉터리(= labs/)의 `.env` 를 읽습니다.
#   docker compose -f labs/compose.yaml up -d            # 통합(labs/.env 사용)
#   docker compose --env-file labs/.env -f labs/node/compose.yaml up -d   # 랩별 실행 시
# `.env` 는 .gitignore 로 커밋되지 않습니다. 실제 키를 커밋하지 마세요.
# 모든 값은 선택이며, 비워 두면 각 compose 의 기본값이 쓰입니다.
# ============================================================

# ── 소셜 로그인(SSO) — PHP·Node·Django 세 엔진이 공유 ──
# 각 공급자 콘솔에서 OAuth 클라이언트를 만들고 아래 콜백 URL을 등록하세요.
#   Google : http://127.0.0.1:{8101|8102|8103}/oauth/google/callback
#   Kakao  : http://127.0.0.1:{8101|8102|8103}/oauth/kakao/callback
#   Naver  : http://127.0.0.1:{8101|8102|8103}/oauth/naver/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 콜백 베이스 URL (엔진별) ──
# 기본값은 각 엔진의 로컬 포트. 리버스 프록시/다른 호스트 사용 시 변경.
OAUTH_REDIRECT_BASE=http://127.0.0.1:8101          # PHP 엔진
NODE_OAUTH_REDIRECT_BASE=http://127.0.0.1:8102     # Node 엔진
DJANGO_OAUTH_REDIRECT_BASE=http://127.0.0.1:8103   # Django 엔진

# ── 데이터베이스 ──
# Django(PostgreSQL) 비밀번호. PHP·Node(MariaDB)는 compose 내부 고정값 사용.
DJANGO_DB_PASSWORD=django-lab

# ── (고급) OAuth 엔드포인트 오버라이드 ──
# 자체호스팅 IdP·로컬 테스트용. 미설정 시 실제 공급자 URL을 사용합니다.
# Node·Django 엔진이 지원하며, 공급자 PREFIX 는 GOOGLE/KAKAO/NAVER.
#   <PREFIX>_AUTHORIZE_URL  — 인가(authorize) 엔드포인트 (브라우저가 접근)
#   <PREFIX>_TOKEN_URL      — 토큰 교환 엔드포인트 (서버가 호출)
#   <PREFIX>_PROFILE_URL    — 프로필 조회 엔드포인트 (서버가 호출)
# 예)
# GOOGLE_AUTHORIZE_URL=
# GOOGLE_TOKEN_URL=
# GOOGLE_PROFILE_URL=
