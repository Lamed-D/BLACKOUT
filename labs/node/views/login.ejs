<%- include('header') %><div class="card mx-auto" style="max-width:430px"><div class="card-body p-4"><h1 class="h4 fw-bold mb-3">로그인</h1>
<% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
<form method="post" action="/login"><input type="hidden" name="csrf" value="<%= csrf %>">
<label class="form-label" for="username">아이디</label><input class="form-control mb-3" id="username" name="username" autocomplete="username" required>
<label class="form-label" for="password">비밀번호</label><input class="form-control mb-3" id="password" name="password" type="password" autocomplete="current-password" required>
<button class="btn btn-primary w-100">로그인</button></form>
<div class="sso-options mt-4"><p class="small text-secondary text-center mb-2">간편 로그인</p>
<a class="sso-button sso-google" href="/oauth/google/login">Google</a>
<a class="sso-button sso-kakao" href="/oauth/kakao/login">Kakao</a>
<a class="sso-button sso-naver" href="/oauth/naver/login">Naver</a></div>
<p class="small mt-3 mb-0">처음이신가요? <a href="/register">회원가입</a></p></div></div>
<style>.sso-options{display:grid;grid-template-columns:repeat(3,1fr);gap:.4rem}.sso-options p{grid-column:1/-1}.sso-button{display:block;border-radius:.5rem;padding:.6rem .2rem;text-align:center;text-decoration:none;font-weight:700;font-size:.85rem}.sso-google{color:#174ea6;background:#e8f0fe}.sso-kakao{color:#191919;background:#fee500}.sso-naver{color:#fff;background:#03c75a}@media(max-width:640px){.sso-options{grid-template-columns:1fr}}</style>
<%- include('footer') %>
