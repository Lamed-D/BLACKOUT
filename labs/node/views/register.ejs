<%- include('header') %><div class="card mx-auto" style="max-width:480px"><div class="card-body p-4"><h1 class="h4 fw-bold mb-3">회원가입</h1>
<% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
<form method="post" action="/register"><input type="hidden" name="csrf" value="<%= csrf %>">
<label class="form-label" for="username">아이디</label><input class="form-control mb-2" id="username" name="username" minlength="3" maxlength="40" pattern="[A-Za-z0-9_]+" required>
<label class="form-label" for="name">이름</label><input class="form-control mb-2" id="name" name="name" maxlength="80">
<label class="form-label" for="email">이메일</label><input class="form-control mb-2" id="email" name="email" type="email" maxlength="120">
<label class="form-label" for="password">비밀번호</label><input class="form-control mb-3" id="password" name="password" type="password" minlength="8" required>
<button class="btn btn-primary w-100">가입하기</button></form></div></div><%- include('footer') %>
