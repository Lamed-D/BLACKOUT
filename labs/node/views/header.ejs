<!doctype html>
<html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> · BLACKOUT Node</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<link rel="stylesheet" href="/style.css">
<style>.post-body{white-space:pre-wrap}.community-hero{background:linear-gradient(120deg,#eff6ff,#f0fdfa)}pre{white-space:pre-wrap;word-break:break-all}.accordion-body code{white-space:pre-wrap;word-break:break-word}.accordion-body{font-size:.95rem}
.sso-options{display:grid;grid-template-columns:repeat(3,1fr);gap:.4rem}.sso-options p{grid-column:1/-1}.sso-button{display:block;border-radius:.5rem;padding:.6rem .2rem;text-align:center;text-decoration:none;font-weight:700;font-size:.85rem}.sso-google{color:#174ea6;background:#e8f0fe}.sso-kakao{color:#191919;background:#fee500}.sso-naver{color:#fff;background:#03c75a}@media(max-width:640px){.sso-options{grid-template-columns:1fr}}</style>
</head><body>
<div class="bg-shape shape-a"></div><div class="bg-shape shape-b"></div>
<nav class="navbar navbar-expand-lg custom-nav"><div class="container">
<a class="navbar-brand" href="/"><i class="bi bi-shield-lock-fill text-primary"></i> BLACKOUT <span class="text-primary">Security</span> Lab <span class="engine-badge engine-node">Node</span></a>
<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-nav"><span class="navbar-toggler-icon"></span></button>
<div class="collapse navbar-collapse" id="main-nav"><div class="navbar-nav ms-auto align-items-lg-center">
<a class="nav-link" href="/">게시판</a><a class="nav-link text-info fw-bold" href="/practice">실습실</a><a class="nav-link text-warning" href="/thoughts">사고들</a>
<% if (user) { %>
<a class="nav-link text-warning" href="/post/write">글쓰기</a>
<a class="nav-link text-success" href="/shop">상점</a>
<a class="nav-link" href="/profile?user_id=<%= user.id %>"><%= user.username %> · <%= user.points %>P</a>
<% if (isAdmin) { %><a class="nav-link text-danger fw-bold" href="/admin">관리자</a><% } %>
<a class="nav-link text-danger" href="/logout">로그아웃</a>
<% } else { %><a class="nav-link text-success fw-bold" href="/login">로그인</a><a class="nav-link" href="/register">회원가입</a><% } %>
</div></div></div></nav>
<main class="container my-5" style="position:relative;z-index:1"><div class="panel">
<% if (notice) { %><div class="alert alert-info" role="status"><%= notice %></div><% } %>
