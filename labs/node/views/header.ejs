<!doctype html>
<html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> · BLACKOUT Node</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<link rel="stylesheet" href="/style.css">
<style>.post-body{white-space:pre-wrap}.community-hero{background:linear-gradient(120deg,#eff6ff,#f0fdfa)}.post-title{max-width:45ch;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}@media(max-width:640px){.mobile-hide{display:none}}</style>
</head><body>
<div class="bg-shape shape-a"></div><div class="bg-shape shape-b"></div>
<nav class="navbar navbar-expand-lg custom-nav"><div class="container">
<a class="navbar-brand" href="/"><i class="bi bi-shield-lock-fill text-primary"></i> BLACKOUT <span class="text-primary">Security</span> Lab <span class="engine-badge engine-node">Node</span></a>
<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-nav" aria-controls="main-nav" aria-expanded="false" aria-label="메뉴 열기"><span class="navbar-toggler-icon"></span></button>
<div class="collapse navbar-collapse" id="main-nav"><div class="navbar-nav ms-auto align-items-lg-center">
<a class="nav-link" href="/">게시판</a><a class="nav-link" href="/shop">상점</a><a class="nav-link" href="/practice">실습실</a>
<% if (user) { %>
<a class="nav-link" href="/profile"><%= user.username %> · <%= user.points %>P</a>
<% if (user.role === 'admin') { %><a class="nav-link" href="/admin">관리자</a><% } %>
<form method="post" action="/logout" class="d-inline"><input type="hidden" name="csrf" value="<%= csrf %>"><button class="btn btn-link nav-link">로그아웃</button></form>
<% } else { %><a class="nav-link" href="/login">로그인</a><a class="nav-link" href="/register">회원가입</a><% } %>
</div></div></div></nav>
<main class="container my-5" style="position:relative;z-index:1"><div class="panel">
<% if (notice) { %><div class="alert alert-info" role="status"><%= notice %></div><% } %>
