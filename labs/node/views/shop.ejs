<%- include('header') %><div class="card mb-4"><div class="card-body p-4"><h1 class="h3 fw-bold">포인트 상점</h1><p class="text-secondary mb-0">모은 포인트로 상품을 구매하세요. <% if (user) { %>현재 <b><%= user.points %>P</b><% } %></p></div></div>
<div class="row g-3"><% for (const product of products) { %><div class="col-md-4"><div class="card h-100"><div class="card-body p-4 d-flex flex-column"><h2 class="h5 fw-bold"><%= product.name %></h2><p class="text-secondary"><%= product.description %></p><p class="mt-auto"><b><%= product.price.toLocaleString('ko-KR') %>P</b> · 재고 <%= product.stock %></p>
<form method="post" action="/shop/<%= product.id %>/buy"><input type="hidden" name="csrf" value="<%= csrf %>"><button class="btn btn-primary w-100" <%= !user || product.stock < 1 ? 'disabled' : '' %>>구매</button></form></div></div></div><% } %></div><%- include('footer') %>
