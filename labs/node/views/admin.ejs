<%- include('header') %><h1 class="h3 fw-bold mb-4">관리자 대시보드</h1>
<div class="row g-4"><div class="col-lg-5"><div class="card"><div class="card-body p-4"><h2 class="h5 fw-bold">공지 작성</h2>
<form method="post" action="/admin/notice"><input type="hidden" name="csrf" value="<%= csrf %>"><label class="form-label" for="notice-title">제목</label><input class="form-control mb-2" id="notice-title" name="title" maxlength="200" required>
<label class="form-label" for="notice-content">내용</label><textarea class="form-control mb-3" id="notice-content" name="content" required></textarea><button class="btn btn-primary">등록</button></form>
<h3 class="h6 fw-bold mt-4">최근 공지</h3><% for (const item of notices) { %><div class="border-bottom py-2"><%= item.title %></div><% } %></div></div></div>
<div class="col-lg-7"><div class="card"><div class="card-body p-4"><h2 class="h5 fw-bold">회원</h2><div class="table-responsive"><table class="table"><thead><tr><th>아이디</th><th>권한</th><th>포인트</th></tr></thead><tbody><% for (const item of users) { %><tr><td><%= item.username %></td><td><%= item.role %></td><td><%= item.points %></td></tr><% } %></tbody></table></div></div></div></div></div>
<%- include('footer') %>
