<%- include('header') %>
<div class="card mb-4"><div class="card-body p-4"><h1 class="h3 fw-bold">실습실 카탈로그</h1>
<p class="text-secondary mb-2">가이드에 적힌 라우트·페이로드를 그대로 실행하면 됩니다. <%= vulns.length %>개 항목 · 파일형 페이로드는 <b>예제 파일</b>을 바로 내려받거나 소스로 볼 수 있습니다. 공격 접근 과정은 <a href="/thoughts">사고들</a>에서.</p>
<a class="btn btn-sm btn-outline-warning" href="/thoughts"><i class="bi bi-lightbulb"></i> 사고들(공격 접근 기록)</a></div></div>

<div class="card mb-4"><div class="card-body"><h5 class="fw-bold mb-3"><i class="bi bi-file-earmark-code"></i> 예제 공격 파일</h5>
<div class="row g-2"><% for (const f of exploits) { %>
<div class="col-md-6"><div class="border rounded p-2 d-flex justify-content-between align-items-center">
<div><code><%= f.name %></code> <span class="small text-secondary d-block"><%= f.desc %></span></div>
<div class="text-nowrap ms-2"><a class="btn btn-sm btn-outline-primary" href="/exploit?name=<%= f.name %>">다운</a>
<a class="btn btn-sm btn-outline-secondary" href="/exploit?name=<%= f.name %>&raw=1" target="_blank">소스</a></div>
</div></div><% } %></div></div></div>

<div class="d-flex gap-2 flex-wrap mb-3" role="group"><button class="btn btn-primary btn-sm filter" data-cat="all">전체</button><% for (const category of categories.filter(item => item.key !== 'all')) { %><button class="btn btn-outline-primary btn-sm filter" data-cat="<%= category.key %>"><%= category.label %></button><% } %></div>

<div class="accordion" id="practice-list"><% for (const item of vulns) { const files = exploits.filter(f => (f.items||[]).includes(item.id)); %>
<div class="accordion-item practice-row" data-cat="<%= item.category %>"><h2 class="accordion-header"><button class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#v<%= item.id %>"><%= item.id %>. <%= item.title %> <span class="diff-badge diff-<%= item.difficulty %> ms-2"><%= item.difficulty %></span></button></h2>
<div class="accordion-collapse collapse" id="v<%= item.id %>" data-bs-parent="#practice-list"><div class="accordion-body">
<p class="mb-1"><b>목표:</b> <%= item.goal %></p><% if (item.route) { %><p class="small mb-1"><b>경로:</b> <code><%= item.route %></code></p><% } %><% if (item.detail) { %><p class="text-secondary"><%= item.detail %></p><% } %><% if (item.diagram) { %><pre><%= item.diagram %></pre><% } %>
<% for (const [index, step] of (item.steps || []).entries()) { %><div class="alert alert-dark mb-2"><b>STEP <%= index + 1 %>.</b> <%= step.desc %><% if (step.payload) { %><div class="d-flex align-items-start gap-2 mt-2"><code class="flex-grow-1 payload"><%= step.payload %></code><button type="button" class="btn btn-sm btn-outline-light copy-btn" title="복사">복사</button></div><% } %></div><% } %>
<% if (files.length) { %><div class="mb-2"><b>예제 파일:</b> <% for (const f of files) { %><a class="badge text-bg-primary text-decoration-none" href="/exploit?name=<%= f.name %>"><i class="bi bi-download"></i> <%= f.name %></a> <a class="badge text-bg-secondary text-decoration-none" href="/exploit?name=<%= f.name %>&raw=1" target="_blank">소스</a> <% } %></div><% } %>
<p class="mb-0"><b>대응책:</b> <%= item.fix %></p></div></div></div><% } %></div>

<script>
document.querySelectorAll('.filter').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll('.filter').forEach(item=>item.classList.replace('btn-primary','btn-outline-primary'));button.classList.replace('btn-outline-primary','btn-primary');document.querySelectorAll('.practice-row').forEach(row=>row.hidden=button.dataset.cat!=='all'&&row.dataset.cat!==button.dataset.cat)}));
document.querySelectorAll('.copy-btn').forEach(b=>b.addEventListener('click',()=>{const c=b.previousElementSibling.textContent;navigator.clipboard&&navigator.clipboard.writeText(c);b.textContent='복사됨';setTimeout(()=>b.textContent='복사',1200);}));
</script>
<%- include('footer') %>
