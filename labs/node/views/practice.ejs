<%- include('header') %><div class="card mb-4"><div class="card-body p-4"><h1 class="h3 fw-bold">실습실 카탈로그</h1><p class="text-secondary mb-0">공유 카탈로그에서 Node 엔진 항목을 읽어 표시합니다. <%= vulns.length %>개 항목</p></div></div>
<div class="d-flex gap-2 flex-wrap mb-3" role="group" aria-label="카테고리"><button class="btn btn-primary btn-sm filter" data-cat="all">전체</button><% for (const category of categories.filter(item => item.key !== 'all')) { %><button class="btn btn-outline-primary btn-sm filter" data-cat="<%= category.key %>"><%= category.label %></button><% } %></div>
<div class="accordion" id="practice-list"><% for (const item of vulns) { %><div class="accordion-item practice-row" data-cat="<%= item.category %>"><h2 class="accordion-header"><button class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#v<%= item.id %>"><%= item.id %>. <%= item.title %> <span class="diff-badge diff-<%= item.difficulty %>"><%= item.difficulty %></span></button></h2>
<div class="accordion-collapse collapse" id="v<%= item.id %>" data-bs-parent="#practice-list"><div class="accordion-body"><p><b>목표:</b> <%= item.goal %></p><p><%= item.detail || '' %></p><% if (item.diagram) { %><pre><%= item.diagram %></pre><% } %>
<% for (const [index, step] of (item.steps || []).entries()) { %><div class="alert alert-dark"><b>STEP <%= index + 1 %>.</b> <%= step.desc %><% if (step.payload) { %><code class="d-block mt-2"><%= step.payload %></code><% } %></div><% } %>
<p><b>대응책:</b> <%= item.fix %></p></div></div></div><% } %></div>
<script>document.querySelectorAll('.filter').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll('.filter').forEach(item=>item.classList.replace('btn-primary','btn-outline-primary'));button.classList.replace('btn-outline-primary','btn-primary');document.querySelectorAll('.practice-row').forEach(row=>row.hidden=button.dataset.cat!=='all'&&row.dataset.cat!==button.dataset.cat)}));</script>
<%- include('footer') %>
